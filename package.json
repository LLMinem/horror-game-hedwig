{
  "name": "horror-game",
  "version": "1.0.0",
  "private": true,
  "description": "Hedwig: an evidence-led, walkable Neuer Friedhof environment built with Three.js.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "lil-gui": "0.20.0",
    "three": "0.179.1"
  },
  "devDependencies": {
    "vite": "7.3.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "references": "python3 tools/references/references.py",
    "browser:smoke": "node tools/browser-smoke.mjs",
    "blender:version": "bash tools/blender/run.sh version",
    "blender:smoke": "bash tools/blender/run.sh smoke",
    "blender:inspect": "bash tools/blender/run.sh inspect",
    "blender:export": "bash tools/blender/run.sh export"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLMinem/horror-game-hedwig.git"
  },
